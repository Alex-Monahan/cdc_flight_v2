#!/usr/bin/env python3
"""Deploy and observe MotherDuck Flights through MotherDuck's Flight SQL functions.

    tools/with-env uv run python tools/flightctl deploy cdc_v2_x --source flights/x/main.py --requirements R --size F16
    tools/with-env uv run python tools/flightctl run cdc_v2_x --wait --logs
    tools/with-env uv run python tools/flightctl --json runs cdc_v2_x

A Flight is named by its name or its id. Only Flights and secrets named cdc_v2* are touched (PLAN §4).
Every subcommand accepts --json (before or after the subcommand) and then prints one JSON document.
Secret values are read from local environment variables (--from-env) and never printed.
Exit status: 0 ok, 1 error, 2 usage; `run --wait` and `wait` exit 3 when the run did not succeed.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from cdc_v2 import flightctl as fc  # noqa: E402


def _read(path):
    if path is None:
        return None
    with open(path, encoding="utf-8") as f:
        return f.read()


def _kv(pairs, what):
    out = {}
    for p in pairs or []:
        if "=" not in p:
            raise fc.FlightCtlError("%s must be KEY=VALUE: %r" % (what, p))
        k, v = p.split("=", 1)
        out[k] = v
    return out


def _definition(a, for_update=False):
    d = {}
    if getattr(a, "requirements", None) is not None:
        d["requirements_txt"] = _read(a.requirements)
    if getattr(a, "requirements_text", None) is not None:
        d["requirements_txt"] = a.requirements_text.replace("\\n", "\n")
    if getattr(a, "no_schedule", False):
        d["schedule_cron"] = ""
    elif getattr(a, "schedule", None) is not None:
        d["schedule_cron"] = a.schedule
    if getattr(a, "config", None):
        d["config"] = _kv(a.config, "--config")
    if getattr(a, "no_config", False):
        d["config"] = {}
    if getattr(a, "secret", None) is not None:
        d["flight_secret_names" if for_update else "secret_names"] = list(a.secret)
    if getattr(a, "no_secrets", False):
        d["flight_secret_names" if for_update else "secret_names"] = []
    if getattr(a, "max_runtime", None) is not None:
        d["max_runtime_sec"] = a.max_runtime
    if getattr(a, "size", None) is not None:
        d["instance_type"] = a.size
    if getattr(a, "token_name", None) is not None:
        d["access_token_name"] = a.token_name
    return d


def _add_definition_args(p, update=False):
    p.add_argument("--source", help="Python source file (main.py)")
    p.add_argument("--requirements", help="requirements.txt file")
    p.add_argument("--requirements-text", help="requirements as text; \\n separates lines")
    p.add_argument("--schedule", help="5-field cron, UTC")
    p.add_argument("--no-schedule", action="store_true", help="clear the schedule")
    p.add_argument("--config", action="append", metavar="KEY=VALUE", help="non-secret env var (full replace)")
    p.add_argument("--no-config", action="store_true", help="replace config with an empty map")
    p.add_argument("--secret", action="append", metavar="SECRET_NAME", help="attach Flight secret (full replace)")
    p.add_argument("--no-secrets", action="store_true", help="detach all secrets")
    p.add_argument("--max-runtime", type=int, metavar="SEC", help="per-run timeout, 0 = none")
    p.add_argument("--size", choices=fc.INSTANCE_TYPES, help="instance type")
    p.add_argument("--token-name", help="label of the owner's access token to run as")
    if update:
        p.add_argument("--rename", help="new name (must start with cdc_v2)")


def _print_human(obj):
    if isinstance(obj, list):
        if not obj:
            print("(none)")
            return
        cols = [c for c in obj[0].keys() if c not in ("config",)]
        for row in obj:
            print("  ".join("%s=%s" % (c, row.get(c)) for c in cols))
    elif isinstance(obj, dict):
        for k, v in obj.items():
            if isinstance(v, (dict, list)):
                v = json.dumps(v)
            print("%s: %s" % (k, v))
    else:
        print(obj)


def _print_logs(lines, as_json):
    if as_json:
        return lines
    for ln in lines:
        print(ln.get("line", ""))
    return None


def main(argv=None):
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")
    ap = argparse.ArgumentParser(prog="flightctl", description=__doc__.split("\n\n")[0], parents=[common],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", parents=[common], help="list cdc_v2* Flights")
    p = sub.add_parser("get", parents=[common], help="one Flight's summary plus its latest version metadata")
    p.add_argument("flight")
    p = sub.add_parser("create", parents=[common], help="create a Flight")
    p.add_argument("name")
    _add_definition_args(p)
    p = sub.add_parser("deploy", parents=[common], help="create, or update in place if the name exists")
    p.add_argument("name")
    _add_definition_args(p)
    p = sub.add_parser("update", parents=[common], help="patch a Flight (only the given fields)")
    p.add_argument("flight")
    _add_definition_args(p, update=True)
    p = sub.add_parser("unschedule", parents=[common], help="remove the schedule (no-op if none)")
    p.add_argument("flight")
    p = sub.add_parser("delete", parents=[common], help="delete a Flight (cancels active runs)")
    p.add_argument("flight")
    p = sub.add_parser("versions", parents=[common], help="version history")
    p.add_argument("flight")
    p.add_argument("--limit", type=int, default=50)
    p = sub.add_parser("source", parents=[common], help="source and requirements of a version")
    p.add_argument("flight")
    p.add_argument("--version", type=int, help="default: current")

    p = sub.add_parser("run", parents=[common], help="run now")
    p.add_argument("flight")
    p.add_argument("--config", action="append", metavar="KEY=VALUE", help="per-run override of an existing key")
    p.add_argument("--wait", action="store_true", help="wait for a terminal state")
    p.add_argument("--logs", action="store_true", help="with --wait: print the logs at the end")
    p.add_argument("--timeout", type=float, default=600)
    p = sub.add_parser("runs", parents=[common], help="list runs, newest first")
    p.add_argument("flight")
    p.add_argument("--limit", type=int, default=20)
    p.add_argument("--active", action="store_true", help="only PENDING and RUNNING")
    p = sub.add_parser("status", parents=[common], help="one run")
    p.add_argument("flight")
    p.add_argument("run_number", type=int)
    p = sub.add_parser("wait", parents=[common], help="wait for a run to end")
    p.add_argument("flight")
    p.add_argument("run_number", type=int)
    p.add_argument("--timeout", type=float, default=600)
    p.add_argument("--logs", action="store_true")
    p = sub.add_parser("cancel", parents=[common], help="cancel a run (default: every active run)")
    p.add_argument("flight")
    p.add_argument("run_number", type=int, nargs="?")
    p = sub.add_parser("logs", parents=[common], help="a run's log lines (default: latest run)")
    p.add_argument("flight")
    p.add_argument("run_number", type=int, nargs="?")
    p.add_argument("--tail", type=int, help="last N lines")

    p = sub.add_parser("secret-set", parents=[common],
                       help="create or replace a Flight secret from local environment variables")
    p.add_argument("name")
    p.add_argument("--from-env", action="append", required=True, metavar="KEY[=ENVVAR]",
                   help="secret key KEY gets the value of local env var ENVVAR (default: KEY)")
    p = sub.add_parser("secret-drop", parents=[common], help="drop a Flight secret")
    p.add_argument("name")
    sub.add_parser("secrets", parents=[common], help="list cdc_v2* secrets (names only)")

    a = ap.parse_args(argv)
    as_json = getattr(a, "json", False)
    ctl = fc.FlightCtl()
    rc = 0
    try:
        out = None
        if a.cmd == "list":
            out = ctl.list_flights()
        elif a.cmd == "get":
            out = ctl.resolve(a.flight)
            vs = ctl.versions(a.flight, limit=1)
            out["latest_version"] = vs[0] if vs else None
        elif a.cmd in ("create", "deploy"):
            src = _read(a.source)
            if src is None:
                raise fc.FlightCtlError("--source is required")
            d = _definition(a)
            if a.cmd == "create" and d.get("schedule_cron") == "":
                d.pop("schedule_cron")
            if a.cmd == "create":
                out = ctl.create(a.name, src, **d)
            else:
                action, out = ctl.deploy(a.name, src, **d)
                out["action"] = action
        elif a.cmd == "update":
            d = _definition(a, for_update=True)
            if a.source:
                d["source_code"] = _read(a.source)
            if a.rename:
                d["name"] = a.rename
            out = ctl.update(a.flight, **d)
        elif a.cmd == "unschedule":
            out = ctl.unschedule(a.flight)
        elif a.cmd == "delete":
            out = ctl.delete(a.flight)
        elif a.cmd == "versions":
            out = ctl.versions(a.flight, a.limit)
        elif a.cmd == "source":
            num = a.version or ctl.resolve(a.flight)["current_version"]
            v = ctl.version(a.flight, num)
            if as_json:
                out = v
            else:
                print("# version %s, requirements:\n%s\n# source:\n%s" % (num, v.get("requirements_txt"),
                                                                          v.get("source_code")))
        elif a.cmd == "run":
            run = ctl.run(a.flight, _kv(a.config, "--config") or None)
            if a.wait:
                if not as_json:
                    print("run %s %s" % (run["run_number"], run.get("state")), flush=True)
                run = ctl.wait(a.flight, run["run_number"], timeout=a.timeout,
                               on_change=None if as_json else
                               (lambda r: print("  state %s" % fc.normalize_status(r["status"]), flush=True)))
                if a.logs:
                    run["logs"] = [ln["line"] for ln in ctl.logs(a.flight, run["run_number"])]
                rc = 0 if run.get("state") == fc.RUN_SUCCEEDED else 3
            out = run
            if a.wait and a.logs and not as_json:
                lines = out.pop("logs")
                _print_human(out)
                print("--- logs ---")
                print("\n".join(lines))
                out = None
        elif a.cmd == "runs":
            out = ctl.runs(a.flight, a.limit)
            if a.active:
                out = [r for r in out if fc.run_is_active(r)]
        elif a.cmd == "status":
            out = ctl.get_run(a.flight, a.run_number)
        elif a.cmd == "wait":
            out = ctl.wait(a.flight, a.run_number, timeout=a.timeout)
            if a.logs:
                out["logs"] = [ln["line"] for ln in ctl.logs(a.flight, a.run_number)]
            rc = 0 if out.get("state") == fc.RUN_SUCCEEDED else 3
        elif a.cmd == "cancel":
            flight = ctl.resolve(a.flight)
            targets = [a.run_number] if a.run_number else [r["run_number"] for r in ctl.active_runs(flight["flight_id"])]
            out = [ctl.cancel_by_id(flight["flight_id"], n) for n in targets]
        elif a.cmd == "logs":
            num = a.run_number
            if num is None:
                runs = ctl.runs(a.flight, 1)
                if not runs:
                    raise fc.FlightCtlError("the Flight has no runs")
                num = runs[0]["run_number"]
            lines = ctl.logs(a.flight, num, limit=a.tail, order="desc" if a.tail else None)
            out = _print_logs(lines, as_json)
        elif a.cmd == "secret-set":
            params = {}
            for spec in a.from_env:
                key, _, var = spec.partition("=")
                var = var or key
                if var not in os.environ:
                    raise fc.FlightCtlError("local environment variable %s is not set" % var)
                params[key] = os.environ[var]
            out = ctl.create_secret(a.name, params)
        elif a.cmd == "secret-drop":
            out = ctl.drop_secret(a.name)
        elif a.cmd == "secrets":
            out = ctl.list_secrets()
        if out is not None:
            if as_json:
                print(json.dumps(out, indent=2, sort_keys=True))
            else:
                _print_human(out)
    except fc.FlightCtlError as exc:
        if as_json:
            print(json.dumps({"error": str(exc)}))
        else:
            print("flightctl: %s" % exc, file=sys.stderr)
        rc = 1
    finally:
        ctl.close()
    return rc


if __name__ == "__main__":
    sys.exit(main())
