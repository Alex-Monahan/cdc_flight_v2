ROLES = {"bootstrap": BOOT, "admin": ADMIN, "runtime": RUNTIME}
DATABASE = "cdc_v2_test"
FORBIDDEN_PORT = 5432
MAX_NODES = 8                       # ports base .. base+7 (55432..55439 by default; 55440+ belong to TCP proxies)
DEFAULT_PORT_BASE = 55432
DEFAULT_HOME = "~/.cache/cdc_flight_v2/pg"
DEFAULT_PG_BIN = "/opt/homebrew/opt/postgresql@18/bin"
MARKER = ".localpg-home"
STATE_VERSION = 1
NAME_RX = re.compile(r"^[a-z][a-z0-9_]{0,23}$")
SETTING_RX = re.compile(r"^[a-z_][a-z0-9_.]{0,62}$")

# Exit codes
EXIT_OK, EXIT_ERROR, EXIT_USAGE, EXIT_NOT_RUNNING = 0, 1, 2, 3

# Timeouts in seconds
T_QUICK, T_SQL, T_CTL, T_BACKUP, T_LOCK = 10, 60, 90, 600, 300

BASE_SETTINGS = [
    ("listen_addresses", "localhost"),
    ("unix_socket_permissions", "0700"),
    ("max_connections", "50"),
    ("shared_buffers", "128MB"),
    ("max_wal_senders", "20"),
