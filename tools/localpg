# Settings that exist only from a given Postgres major version on. localpg writes them only for a node whose data
# directory is of that version or newer, and `set` refuses them on an older node with a message instead of an SQL
# error. Failover slots and their synchronisation (failover = true, sync_replication_slots,
# synchronized_standby_slots) are Postgres 17+; the idle slot timeout is 18+.
SINCE = {"sync_replication_slots": 17, "synchronized_standby_slots": 17, "idle_replication_slot_timeout": 18}

# Columns of pg_replication_slots that `status` shows; a column the server does not have is reported as null.
SLOT_COLUMNS = ("slot_name", "slot_type", "plugin", "database", "active", "active_pid", "wal_status", "temporary",
                "failover", "synced", "conflicting", "invalidation_reason", "restart_lsn", "confirmed_flush_lsn")

# A hot standby refuses to run with a smaller value of these than its primary.
STANDBY_MATCHED = {"max_connections", "max_worker_processes", "max_wal_senders", "max_prepared_transactions",
                   "max_locks_per_transaction"}


class Fail(Exception):
    def __init__(self, msg, code=EXIT_ERROR):
        super().__init__(msg)
        self.code = code


def say(msg):
    print(msg, flush=True)


def note(msg):
    print("localpg: " + msg, file=sys.stderr, flush=True)


# --------------------------------------------------------------------------------------------------- configuration

class Config:
    def __init__(self, home=None, port_base=None, pg_bin=None):
        raw = home or os.environ.get("CDC_V2_PG_HOME") or DEFAULT_HOME
        self.home = os.path.abspath(os.path.expanduser(raw))
        self.pg_bin = os.path.abspath(os.path.expanduser(pg_bin or os.environ.get("CDC_V2_PG_BIN") or DEFAULT_PG_BIN))
        pb = port_base if port_base is not None else os.environ.get("CDC_V2_PG_PORT_BASE")
        self.port_base_explicit = pb is not None
        try:
            self.port_base = int(pb) if pb is not None else DEFAULT_PORT_BASE
        except ValueError:
            raise Fail("port base %r is not a number" % (pb,), EXIT_USAGE)
        check_port_base(self.port_base)
        check_home(self.home)
        self.run_dir = os.path.join(self.home, "run")
        self.tls_dir = os.path.join(self.home, "tls")
        self.secrets_dir = os.path.join(self.home, "secrets")
        self.log_dir = os.path.join(self.home, "logs")
        self.nodes_dir = os.path.join(self.home, "nodes")
        self.state_file = os.path.join(self.home, "state.json")
        self.passwords_json = os.path.join(self.secrets_dir, "passwords.json")
        self.pgpass = os.path.join(self.secrets_dir, "pgpass")
        self.ca_cert = os.path.join(self.tls_dir, "ca.crt")
        self.server_cert = os.path.join(self.tls_dir, "server.crt")
        self.server_key = os.path.join(self.tls_dir, "server.key")
        if len(self.run_dir) + len("/.s.PGSQL.65535.lock") > 103:
            raise Fail("home path too long for a Unix socket directory (%s)" % self.run_dir, EXIT_USAGE)

    def bin(self, name):
        path = os.path.join(self.pg_bin, name)
        if not os.access(path, os.X_OK):
            raise Fail("%s not found in %s (set CDC_V2_PG_BIN)" % (name, self.pg_bin), EXIT_USAGE)
        return path

    def ports(self):
        return range(self.port_base, self.port_base + MAX_NODES)

    def data_dir(self, name):
        return os.path.join(self.nodes_dir, name, "data")

    def log_file(self, name):
        return os.path.join(self.log_dir, name + ".log")

    def bin_major(self):
        """Major version of the binaries in pg_bin (from `postgres --version`)."""
        if getattr(self, "_bin_major", None) is None:
            out = run([self.bin("postgres"), "--version"], T_QUICK).stdout
            m = re.search(r"\(PostgreSQL\)\s+(\d+)", out)
            if not m:
                raise Fail("cannot read the Postgres version from %r" % out.strip())
            self._bin_major = int(m.group(1))
        return self._bin_major


def data_major(cfg, name):
    """Major version of a node's data directory (its PG_VERSION file), or None if there is none."""
    try:
        with open(os.path.join(cfg.data_dir(name), "PG_VERSION")) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def check_versions(cfg, name):
    """Refuse to run binaries of one major version on a data directory of another."""
    dm = data_major(cfg, name)
    if dm is not None and dm != cfg.bin_major():
        raise Fail("%s has a Postgres %d data directory, but the binaries in %s are Postgres %d; use the matching "
                   "--pg-bin / CDC_V2_PG_BIN, another home, or `localpg reset`" % (name, dm, cfg.pg_bin,
                                                                                  cfg.bin_major()), EXIT_USAGE)


def check_port_base(base):
    top = base + MAX_NODES - 1
    if base <= FORBIDDEN_PORT <= top:
        raise Fail("refused: port range %d-%d would include %d, which belongs to a Postgres outside this build"
                   % (base, top, FORBIDDEN_PORT), EXIT_USAGE)
    if base < 1024 or top > 65535:
        raise Fail("refused: port range %d-%d is outside 1024-65535" % (base, top), EXIT_USAGE)


def check_home(home):
    real = os.path.realpath(home)
    user_home = os.path.realpath(os.path.expanduser("~"))
    forbidden = ["/opt/homebrew/var", "/usr/local/var"]
    if real in ("/", user_home) or os.path.dirname(real) == "/" or real.startswith(user_home + "/Public"):
        raise Fail("refused: %s cannot be a localpg home" % home, EXIT_USAGE)
    for f in forbidden:
        if real == f or real.startswith(f + "/"):
            raise Fail("refused: %s is under %s, which belongs to a Postgres outside this build" % (home, f),
                       EXIT_USAGE)


# --------------------------------------------------------------------------------------------------- subprocesses

def clean_env(cfg):
    env = {k: v for k, v in os.environ.items() if not k.startswith("PG")}
    env.update({"PGPASSFILE": cfg.pgpass, "PGCONNECT_TIMEOUT": "5", "PGGSSENCMODE": "disable",
                "PGAPPNAME": "localpg", "LC_ALL": "C", "LANG": "C"})
    return env


def run(cmd, timeout, cfg=None, input=None, check=True, env=None):
    """Run a command with a hard timeout. Returns CompletedProcess with text output."""
    if env is None:
        env = clean_env(cfg) if cfg else dict(os.environ, LC_ALL="C")
    try:
        p = subprocess.run(cmd, input=input, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                           timeout=timeout, env=env, stdin=None if input is not None else subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise Fail("timed out after %ds: %s" % (timeout, os.path.basename(cmd[0]) + " " + " ".join(cmd[1:3])))
    if check and p.returncode != 0:
        msg = (p.stderr or p.stdout or "").strip().splitlines()
        raise Fail("%s failed (exit %d): %s" % (os.path.basename(cmd[0]), p.returncode,
                                                 msg[-1] if msg else "no output"))
    return p


def assert_own_port(cfg, port):
    if port == FORBIDDEN_PORT or port not in cfg.ports():
        raise Fail("refused: port %s is not one of this home's ports (%d-%d)"
                   % (port, cfg.port_base, cfg.port_base + MAX_NODES - 1), EXIT_USAGE)


def psql(cfg, port, sql, db="postgres", user=BOOT, timeout=T_SQL, check=True):
    """Run SQL through the private Unix socket. Statements are fed on stdin (never on the command line)."""
    assert_own_port(cfg, port)
    cmd = [cfg.bin("psql"), "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1", "-h", cfg.run_dir, "-p", str(port),
           "-U", user, "-d", db, "-f", "-"]
    env = clean_env(cfg)
    env["PGOPTIONS"] = "-c statement_timeout=%d" % ((timeout - 5) * 1000)
    p = run(cmd, timeout, input=sql, check=check, env=env)
    return p.stdout.strip() if p.returncode == 0 else None


def psql_json(cfg, port, sql, **kw):
    out = psql(cfg, port, sql, **kw)
    return json.loads(out) if out else None


def lit(s):
    return "'" + str(s).replace("'", "''") + "'"


def ident(s):
    return '"' + s.replace('"', '""') + '"'


def libpq_quote(v):
    return "'" + str(v).replace("\\", "\\\\").replace("'", "\\'") + "'"


# --------------------------------------------------------------------------------------------------- process identity

def ps_start_epoch(pid):
    p = run(["/bin/ps", "-o", "lstart=", "-p", str(pid)], T_QUICK, check=False)
    text = p.stdout.strip()
    if p.returncode != 0 or not text:
        return None
    try:
        return time.mktime(time.strptime(text, "%a %b %d %H:%M:%S %Y"))
    except ValueError:
        return None


def child_pids(pid):
    p = run(["/bin/ps", "-A", "-o", "pid=", "-o", "ppid="], T_QUICK)
    out = []
    for line in p.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == str(pid):
            out.append(int(parts[0]))
    return out


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


class Postmaster:
    def __init__(self, pid, start, port, status):
        self.pid, self.start, self.port, self.status = pid, start, port, status


def postmaster_of(cfg, name):
    """The verified postmaster of a node, or None. Verification: the pid file is in this node's data directory, names
    that directory, and the process with that pid exists and started when the pid file says it did."""
    data = cfg.data_dir(name)
    try:
        with open(os.path.join(data, "postmaster.pid")) as f:
            lines = f.read().splitlines()
        pid, datadir, start, port = int(lines[0]), lines[1], int(lines[2]), int(lines[3])
    except (OSError, ValueError, IndexError):
        return None
    if os.path.realpath(datadir) != os.path.realpath(data):
        return None
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return None
    st = ps_start_epoch(pid)
    if st is None or abs(st - start) > 5:
        return None
    status = lines[7].strip() if len(lines) > 7 else ""
    return Postmaster(pid, start, port, status)


def process_stopped(pid):
    st = run(["/bin/ps", "-o", "stat=", "-p", str(pid)], T_QUICK, check=False).stdout.strip()
    return not st or st.startswith("T")


def wait_gone(pids, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        left = [p for p in pids if alive(p)]
        if not left:
            return []
        time.sleep(0.05)
    return [p for p in pids if alive(p)]


def hard_kill(cfg, name):
    """SIGKILL a node's postmaster and every child it has, leaving no orphaned backend. The postmaster is stopped
    first (SIGSTOP) so it cannot fork while its children are collected. Returns the killed pids, or [] if the node
    was not running."""
    pm = postmaster_of(cfg, name)
    if not pm:
        return []
    os.kill(pm.pid, signal.SIGSTOP)
    kids = []
    try:
        deadline = time.time() + 5
        while time.time() < deadline and not process_stopped(pm.pid):
            time.sleep(0.01)
        kids = child_pids(pm.pid)
        for k in kids:
            with contextlib.suppress(ProcessLookupError):
                os.kill(k, signal.SIGKILL)
    finally:
        with contextlib.suppress(ProcessLookupError):
            os.kill(pm.pid, signal.SIGKILL)
    left = wait_gone([pm.pid] + kids, 15)
    if left:
        raise Fail("%s: processes still present after SIGKILL: %s" % (name, left))
    return [pm.pid] + kids


# --------------------------------------------------------------------------------------------------- state

def load_state(cfg):
    try:
        with open(cfg.state_file) as f:
            st = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return {"version": STATE_VERSION, "initialized": False, "nodes": {}, "port_base": cfg.port_base}
    if cfg.port_base_explicit and st.get("port_base") != cfg.port_base:
        raise Fail("home %s was built with port base %s, not %d (use another home or reset with the old base)"
                   % (cfg.home, st.get("port_base"), cfg.port_base), EXIT_USAGE)
    cfg.port_base = st.get("port_base", cfg.port_base)
    check_port_base(cfg.port_base)
    return st


def save_state(cfg, st):
    tmp = cfg.state_file + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, sort_keys=True)
    os.replace(tmp, cfg.state_file)


def require_state(cfg):
    st = load_state(cfg)
    if not st or not st.get("initialized"):
        raise Fail("no cluster in %s (run `localpg up`)" % cfg.home)
    return st


def resolve_node(cfg, st, ident_):
    if ident_ in st["nodes"]:
        return ident_
    if ident_.isdigit():
        for n, node in st["nodes"].items():
            if node["port"] == int(ident_):
                return n
    raise Fail("unknown node %r (known: %s)" % (ident_, ", ".join(sorted(st["nodes"]))), EXIT_USAGE)


def is_standby_dir(cfg, name):
    return os.path.exists(os.path.join(cfg.data_dir(name), "standby.signal"))


def ordered_nodes(cfg, st, standbys_first=False):
    names = sorted(st["nodes"], key=lambda n: st["nodes"][n]["port"])
    prim = [n for n in names if not is_standby_dir(cfg, n)]
    stby = [n for n in names if is_standby_dir(cfg, n)]
    return stby + prim if standbys_first else prim + stby


@contextlib.contextmanager
def home_lock(cfg):
    os.makedirs(cfg.home, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(cfg.home, ".lock"), os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.time() + T_LOCK
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as e:
                if e.errno not in (errno.EAGAIN, errno.EACCES) or time.time() > deadline:
                    raise Fail("another localpg holds the lock on %s" % cfg.home)
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


# --------------------------------------------------------------------------------------------------- TLS and passwords

def openssl_bin():
    exe = os.environ.get("CDC_V2_OPENSSL") or shutil.which("openssl", path="/opt/homebrew/bin:" +
                                                           os.environ.get("PATH", ""))
    if not exe:
        raise Fail("openssl not found (set CDC_V2_OPENSSL)")
    return exe


def make_tls(cfg):
    os.makedirs(cfg.tls_dir, mode=0o700, exist_ok=True)
    ossl = openssl_bin()
    d = cfg.tls_dir
    ca_key = os.path.join(d, "ca.key")
    cnf = os.path.join(d, "openssl.cnf")
    with open(cnf, "w") as f:
        f.write("[req]\ndistinguished_name = dn_ca\nprompt = no\n"
                "[dn_ca]\nCN = cdc_v2 localpg CA\n"
                "[dn_srv]\nCN = localhost\n"
                "[v3_ca]\nbasicConstraints = critical, CA:TRUE\nkeyUsage = critical, keyCertSign, cRLSign\n"
                "subjectKeyIdentifier = hash\n"
                "[v3_srv]\nbasicConstraints = critical, CA:FALSE\nkeyUsage = critical, digitalSignature\n"
                "extendedKeyUsage = serverAuth\nsubjectAltName = DNS:localhost, IP:127.0.0.1, IP:::1\n"
                "subjectKeyIdentifier = hash\nauthorityKeyIdentifier = keyid, issuer\n")
    old = os.umask(0o077)
    try:
        gen = [ossl, "genpkey", "-algorithm", "EC", "-pkeyopt", "ec_paramgen_curve:P-256", "-out"]
        run(gen + [ca_key], T_QUICK)
        run([ossl, "req", "-new", "-x509", "-key", ca_key, "-out", cfg.ca_cert, "-days", "3650", "-config", cnf,
             "-extensions", "v3_ca"], T_QUICK)
        run(gen + [cfg.server_key], T_QUICK)
        csr = os.path.join(d, "server.csr")
        run([ossl, "req", "-new", "-key", cfg.server_key, "-out", csr, "-subj", "/CN=localhost", "-config", cnf],
            T_QUICK)
        run([ossl, "x509", "-req", "-in", csr, "-CA", cfg.ca_cert, "-CAkey", ca_key, "-out", cfg.server_cert,
             "-days", "825", "-set_serial", "0x" + secrets.token_hex(12), "-extfile", cnf, "-extensions", "v3_srv"],
            T_QUICK)
        os.unlink(csr)
    finally:
        os.umask(old)
    for p in (ca_key, cfg.server_key):
        os.chmod(p, 0o600)
    for p in (cfg.ca_cert, cfg.server_cert):
        os.chmod(p, 0o644)


def scram_verifier(pw, iterations=4096):
    """SCRAM-SHA-256 verifier in Postgres' stored format, so the plain text never reaches the server or its log."""
    salt = os.urandom(16)
    salted = hashlib.pbkdf2_hmac("sha256", pw.encode(), salt, iterations)
    client_key = hmac.new(salted, b"Client Key", "sha256").digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted, b"Server Key", "sha256").digest()
    b64 = lambda b: base64.b64encode(b).decode()
    return "SCRAM-SHA-256$%d:%s$%s:%s" % (iterations, b64(salt), b64(stored_key), b64(server_key))


def write_private(path, text):
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(path + ".tmp", 0o600)
    os.replace(path + ".tmp", path)


def make_passwords(cfg):
    os.makedirs(cfg.secrets_dir, mode=0o700, exist_ok=True)
    creds = {kind: {"user": role, "password": secrets.token_urlsafe(24)} for kind, role in ROLES.items()}
    write_private(cfg.passwords_json, json.dumps(creds, indent=2) + "\n")
    hosts = ["localhost", "127.0.0.1", "\\:\\:1", cfg.run_dir.replace("\\", "\\\\").replace(":", "\\:")]
    lines = ["# generated by tools/localpg - libpq password file (PGPASSFILE / passfile=)"]
    for c in creds.values():
        for h in hosts:
            lines.append("%s:*:*:%s:%s" % (h, c["user"], c["password"]))
    write_private(cfg.pgpass, "\n".join(lines) + "\n")
    return creds


def load_passwords(cfg):
    try:
        with open(cfg.passwords_json) as f:
            return json.load(f)
    except (OSError, ValueError):
        raise Fail("password file missing or unreadable (%s); run `localpg reset`" % cfg.passwords_json)


# --------------------------------------------------------------------------------------------------- node config

def conf_line(k, v):
    return "%s = %s\n" % (k, "'" + str(v).replace("'", "''") + "'")


def write_node_conf(cfg, st, name):
    node = st["nodes"][name]
    data = cfg.data_dir(name)
    lines = ["# Managed by tools/localpg; rewritten on every change. Overrides: localpg_overrides.conf "
             "(`localpg set`).\n"]
    lines.append(conf_line("port", node["port"]))
    lines.append(conf_line("cluster_name", "cdc_v2_" + name))
    lines.append(conf_line("unix_socket_directories", cfg.run_dir))
    major = data_major(cfg, name) or cfg.bin_major()
    for k, v in BASE_SETTINGS:
        if major >= SINCE.get(k, 0):
            lines.append(conf_line(k, v))
    lines.append(conf_line("ssl_cert_file", cfg.server_cert))
    lines.append(conf_line("ssl_key_file", cfg.server_key))
    up = node.get("upstream")
    if up:
        upport = st["nodes"][up]["port"]
        assert_own_port(cfg, upport)
        conninfo = " ".join("%s=%s" % (k, libpq_quote(v)) for k, v in [
            ("host", cfg.run_dir), ("port", upport), ("user", BOOT), ("passfile", cfg.pgpass),
            ("dbname", "postgres"), ("application_name", name), ("connect_timeout", 5)])
        lines.append(conf_line("primary_conninfo", conninfo))
        lines.append(conf_line("primary_slot_name", node["slot"]))
    lines.append("include_if_exists = 'localpg_overrides.conf'\n")
    with open(os.path.join(data, "localpg.conf"), "w") as f:
        f.writelines(lines)
    ov = node.get("overrides", {})
    with open(os.path.join(data, "localpg_overrides.conf"), "w") as f:
        f.write("# Managed by tools/localpg (`localpg set` / `localpg unset`).\n")
        for k in sorted(ov):
            f.write(conf_line(k, ov[k]))


