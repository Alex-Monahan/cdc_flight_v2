    ("max_worker_processes", "16"),
    ("wal_level", "logical"),
    ("hot_standby", "on"),
    ("hot_standby_feedback", "on"),
    ("wal_retrieve_retry_interval", "1s"),     # standbys reconnect within ~1 s after a primary restart or crash
    ("sync_replication_slots", "on"),          # 17+ only (see SINCE)
    ("ssl", "on"),
    ("ssl_min_protocol_version", "TLSv1.2"),
    ("password_encryption", "scram-sha-256"),
    ("log_line_prefix", "%m [%p] %q%u@%d "),
