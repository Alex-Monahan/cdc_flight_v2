#!/usr/bin/env python3
"""localpg - the only way this build manages its local Postgres clusters (PLAN §5, tier T1).

Python 3 standard library only. Runs the Homebrew formula's own binaries from $CDC_V2_PG_BIN; never `brew services`.
Data, TLS material and generated passwords live under $CDC_V2_PG_HOME (default ~/.cache/cdc_flight_v2/pg).

Safety rules that are enforced in code:
  * every Postgres client invocation names its host (the private socket directory) and port explicitly, the port is
    checked against this home's port range, and a port range that would contain 5432 is refused;
  * all PG* variables of the caller are removed from the environment of every subprocess;
  * a server process is only ever signalled after it was identified through the postmaster.pid of one of this home's
    data directories (pid, data directory and start time verified), or as a child of such a postmaster;
  * every subprocess call has a timeout.

Run `localpg --help` or see docs/localpg.md.
"""
from __future__ import annotations

