hostssl   replication  {boot}   127.0.0.1/32   reject
hostssl   replication  {boot}   ::1/128        reject
hostssl   all          all           127.0.0.1/32   scram-sha-256
hostssl   all          all           ::1/128        scram-sha-256
hostssl   replication  all           127.0.0.1/32   scram-sha-256
hostssl   replication  all           ::1/128        scram-sha-256
hostnossl all          all           0.0.0.0/0      reject
hostnossl all          all           ::/0           reject
hostnossl replication  all           0.0.0.0/0      reject
hostnossl replication  all           ::/0           reject
"""


# --------------------------------------------------------------------------------------------------- node lifecycle

def start_node(cfg, name, wait=True):
    if postmaster_of(cfg, name):
        return False
    check_versions(cfg, name)
    data = cfg.data_dir(name)
    os.makedirs(cfg.run_dir, mode=0o700, exist_ok=True)
    os.makedirs(cfg.log_dir, mode=0o700, exist_ok=True)
    log = cfg.log_file(name)
    size = os.path.getsize(log) if os.path.exists(log) else 0
    cmd = [cfg.bin("pg_ctl"), "start", "-D", data, "-l", log, "-t", "60"] + (["-w"] if wait else ["-W"])
    p = run(cmd, T_CTL, cfg=cfg, check=False)
    if p.returncode != 0:
        raise Fail("%s did not start: %s (log: %s)" % (name, last_log_error(log, size), log))
    return True


def last_log_error(log, offset):
    try:
        with open(log, errors="replace") as f:
            f.seek(offset)
            lines = f.read().splitlines()
    except OSError:
        return "no log"
    bad = [l for l in lines if re.search(r"\b(FATAL|PANIC|ERROR)\b", l)]
    return (bad or lines or ["no log output"])[-1].strip()


def stop_node(cfg, name, mode="fast"):
    """Stop a node and wait until the postmaster and all its children are gone. Escalates to immediate shutdown and
    finally to SIGKILL. Returns True if the node was running."""
    pm = postmaster_of(cfg, name)
    if not pm:
        return False
    if process_stopped(pm.pid):          # a frozen postmaster (SIGSTOP) cannot act on a shutdown request
        os.kill(pm.pid, signal.SIGCONT)
    kids = child_pids(pm.pid)
    p = run([cfg.bin("pg_ctl"), "stop", "-D", cfg.data_dir(name), "-m", mode, "-w", "-t", "60"], T_CTL, cfg=cfg,
            check=False)
    if p.returncode != 0 and postmaster_of(cfg, name):
        note("%s: %s shutdown failed, trying immediate" % (name, mode))
        run([cfg.bin("pg_ctl"), "stop", "-D", cfg.data_dir(name), "-m", "immediate", "-w", "-t", "30"], T_CTL,
            cfg=cfg, check=False)
    if postmaster_of(cfg, name):
        hard_kill(cfg, name)
    left = wait_gone([pm.pid] + kids, 15)
    for k in left:          # children of the identified postmaster that outlived it
        with contextlib.suppress(ProcessLookupError):
            os.kill(k, signal.SIGKILL)
    if wait_gone(left, 5):
        raise Fail("%s: processes still present after stop: %s" % (name, left))
    return True


def node_info(cfg, port):
    info = psql_json(cfg, port, """
select json_build_object(
  'in_recovery', pg_is_in_recovery(),
  'server_version', current_setting('server_version'),
  'current_lsn', case when pg_is_in_recovery() then null else pg_current_wal_lsn()::text end,
  'walfile_tli', case when pg_is_in_recovery() then null else substr(pg_walfile_name(pg_current_wal_lsn()), 1, 8) end,
  'checkpoint_tli', (pg_control_checkpoint()).timeline_id,
  'receive_lsn', pg_last_wal_receive_lsn()::text,
  'replay_lsn', pg_last_wal_replay_lsn()::text,
  'replay_age_s', extract(epoch from now() - pg_last_xact_replay_timestamp()),
  'replay_pause_state', case when pg_is_in_recovery() then pg_get_wal_replay_pause_state() end,
  'wal_receiver', (select row_to_json(r) from (select status, received_tli, sender_port, slot_name
                   from pg_stat_wal_receiver) r),
  'replication', (select coalesce(json_agg(row_to_json(r) order by application_name), '[]'::json) from (
                   select application_name, state, sent_lsn::text, write_lsn::text, flush_lsn::text,
                          replay_lsn::text, extract(epoch from replay_lag) as replay_lag_s, sync_state
                   from pg_stat_replication) r),
  'server_version_num', current_setting('server_version_num')::int,
  'slots', (select coalesce(json_agg(to_jsonb(s) order by s.slot_name), '[]'::json) from pg_replication_slots s))
""", timeout=T_QUICK + 10)
    if info:        # the columns of pg_replication_slots differ between versions: keep ours, absent ones are null
        info["slots"] = [{k: s.get(k) for k in SLOT_COLUMNS} for s in info.get("slots") or []]
    return info


def timeline_of(info):
    if info.get("walfile_tli"):
        return int(info["walfile_tli"], 16)
    wr = info.get("wal_receiver") or {}
    return wr.get("received_tli") or info.get("checkpoint_tli")


def lsn_int(s):
    if not s:
        return None
    hi, lo = s.split("/")
    return (int(hi, 16) << 32) + int(lo, 16)


def wait_streaming(cfg, st, name, timeout=60):
    port = st["nodes"][name]["port"]
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        info = psql_json(cfg, port, "select row_to_json(r) from (select status from pg_stat_wal_receiver) r",
                         timeout=T_QUICK + 5, check=False)
        last = (info or {}).get("status")
        if last == "streaming":
            return True
        time.sleep(0.1)
    raise Fail("%s: WAL receiver not streaming after %ds (status %s)" % (name, timeout, last))


def current_primary(cfg, st, explicit=None):
    if explicit:
        name = resolve_node(cfg, st, explicit)
        pm = postmaster_of(cfg, name)
        if not pm or psql(cfg, st["nodes"][name]["port"], "select pg_is_in_recovery()") != "f":
            raise Fail("%s is not a running primary" % name)
        return name
    found = []
    for name in ordered_nodes(cfg, st):
        if is_standby_dir(cfg, name) or not postmaster_of(cfg, name):
            continue
        if psql(cfg, st["nodes"][name]["port"], "select pg_is_in_recovery()") == "f":
            found.append(name)
    if not found:
        raise Fail("no running primary (run `localpg up`)")
    if len(found) > 1:
        raise Fail("more than one running primary (%s); name one with --from" % ", ".join(found), EXIT_USAGE)
    return found[0]


def init_primary(cfg, st, name, port):
    creds = load_passwords(cfg)
    data = cfg.data_dir(name)
    shutil.rmtree(os.path.dirname(data), ignore_errors=True)
    os.makedirs(os.path.dirname(data), mode=0o700)
    pwfile = os.path.join(cfg.secrets_dir, "initdb.pw")
    write_private(pwfile, creds["bootstrap"]["password"] + "\n")
    try:
        run([cfg.bin("initdb"), "-D", data, "-U", BOOT, "--pwfile", pwfile, "--auth", "scram-sha-256",
             "--encoding", "UTF8", "--locale", "C", "--no-sync", "--data-checksums"], T_BACKUP, cfg=cfg)
    finally:
        with contextlib.suppress(OSError):
            os.unlink(pwfile)
    with open(os.path.join(data, "postgresql.conf"), "a") as f:
        f.write("\n# tools/localpg settings (override everything above)\ninclude = 'localpg.conf'\n")
    with open(os.path.join(data, "pg_hba.conf"), "w") as f:
        f.write(HBA.format(boot=BOOT.ljust(13)))
    st["nodes"][name] = {"port": port, "upstream": None, "slot": None, "ready": False, "overrides": {}}
    save_state(cfg, st)
    write_node_conf(cfg, st, name)
    start_node(cfg, name)
    psql(cfg, port, """
create role {admin} with login nosuperuser createdb createrole replication password {apw};
grant pg_monitor, pg_signal_backend to {admin} with admin option;
""".format(admin=ADMIN, apw=lit(scram_verifier(creds["admin"]["password"]))))
    # The admin role creates the runtime role and the test database, as on a managed provider.
    psql(cfg, port, """
create role {rt} with login nosuperuser replication password {rpw};
create database {db};
""".format(rt=RUNTIME, rpw=lit(scram_verifier(creds["runtime"]["password"])), db=DATABASE), user=ADMIN)
    st["nodes"][name]["ready"] = True
    save_state(cfg, st)


def create_standby(cfg, st, name, port, upstream):
    assert_own_port(cfg, port)
    upport = st["nodes"][upstream]["port"]
    slot = "cdc_v2_phys_" + name
    # a hot standby needs the STANDBY_MATCHED settings at least as high as its upstream: inherit its overrides
    inherited = {k: v for k, v in st["nodes"][upstream].get("overrides", {}).items() if k in STANDBY_MATCHED}
    st["nodes"][name] = {"port": port, "upstream": upstream, "slot": slot, "ready": False, "overrides": inherited}
    save_state(cfg, st)
    psql(cfg, upport, "select pg_create_physical_replication_slot({s}, true) where not exists "
                      "(select 1 from pg_replication_slots where slot_name = {s});".format(s=lit(slot)))
    data = cfg.data_dir(name)
    shutil.rmtree(os.path.dirname(data), ignore_errors=True)
    os.makedirs(os.path.dirname(data), mode=0o700)
    run([cfg.bin("pg_basebackup"), "-h", cfg.run_dir, "-p", str(upport), "-U", BOOT, "-w", "-D", data,
         "-X", "stream", "-S", slot, "-c", "fast", "--no-sync"], T_BACKUP, cfg=cfg)
    open(os.path.join(data, "standby.signal"), "w").close()
    write_node_conf(cfg, st, name)
    start_node(cfg, name)
    wait_streaming(cfg, st, name)
    st["nodes"][name]["ready"] = True
    save_state(cfg, st)


def drop_slot_on(cfg, st, host_node, slot):
    """Best effort: drop a physical slot on a running node."""
    if not host_node or host_node not in st["nodes"] or not postmaster_of(cfg, host_node):
        return False
    out = psql(cfg, st["nodes"][host_node]["port"],
               "select count(pg_drop_replication_slot(slot_name)) from pg_replication_slots "
               "where slot_name = {s} and not active;".format(s=lit(slot)), check=False)
    return out not in (None, "0")


def remove_node(cfg, st, name):
    node = st["nodes"][name]
    stop_node(cfg, name)
    if node.get("slot"):
        drop_slot_on(cfg, st, node.get("upstream"), node["slot"])
    shutil.rmtree(os.path.join(cfg.nodes_dir, name), ignore_errors=True)
    del st["nodes"][name]
    save_state(cfg, st)


def stop_everything_found(cfg, kill=False):
    """Stop every postmaster found through a pid file under this home (state or not): standbys first."""
    if not os.path.isdir(cfg.nodes_dir):
        return []
    names = sorted(os.listdir(cfg.nodes_dir), key=lambda n: (not is_standby_dir(cfg, n), n))
    stopped = []
    for n in names:
        if os.path.isdir(cfg.data_dir(n)):
            if (hard_kill(cfg, n) if kill else stop_node(cfg, n)):
                stopped.append(n)
    return stopped


def wipe_home(cfg):
    if os.path.isdir(cfg.home):
        entries = set(os.listdir(cfg.home)) - {".lock", MARKER}
        if entries and not os.path.exists(os.path.join(cfg.home, MARKER)):
            raise Fail("refused: %s is not empty and is not a localpg home (no %s marker)" % (cfg.home, MARKER),
                       EXIT_USAGE)
        for e in entries:
            p = os.path.join(cfg.home, e)
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p)
            else:
                os.unlink(p)
    os.makedirs(cfg.home, mode=0o700, exist_ok=True)
    with open(os.path.join(cfg.home, MARKER), "w") as f:
        f.write("This directory is managed by tools/localpg of cdc_flight_v2. `localpg reset` wipes it.\n")


def build_fresh(cfg):
    stop_everything_found(cfg)
    wipe_home(cfg)
    for d in (cfg.run_dir, cfg.log_dir, cfg.nodes_dir):
        os.makedirs(d, mode=0o700, exist_ok=True)
    st = {"version": STATE_VERSION, "initialized": False, "port_base": cfg.port_base, "nodes": {},
          "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "pg_major": cfg.bin_major()}
    save_state(cfg, st)
    make_tls(cfg)
    make_passwords(cfg)
    init_primary(cfg, st, "primary", cfg.port_base)
    create_standby(cfg, st, "replica", cfg.port_base + 1, "primary")
    st["initialized"] = True
    save_state(cfg, st)
    return st


# --------------------------------------------------------------------------------------------------- commands

def cmd_up(cfg, args):
    t0 = time.time()
    with home_lock(cfg):
        st = load_state(cfg)
        if not st or not st.get("initialized"):
            if st is not None or (os.path.isdir(cfg.home) and set(os.listdir(cfg.home)) - {".lock", MARKER}):
                note("half-initialised home found; rebuilding it")
            build_fresh(cfg)
            say("up: built and started primary (%d) and replica (%d) in %.1f s"
                % (cfg.port_base, cfg.port_base + 1, time.time() - t0))
            return EXIT_OK
        for name in [n for n, node in st["nodes"].items() if not node.get("ready")]:
            note("discarding half-created node %s" % name)
            remove_node(cfg, st, name)
        report = []
        for name in ordered_nodes(cfg, st):
            report.append("%s (%d) %s" % (name, st["nodes"][name]["port"],
                                          "started" if start_node(cfg, name) else "already running"))
        for name in ordered_nodes(cfg, st):
            up = st["nodes"][name].get("upstream")
            if is_standby_dir(cfg, name) and up in st["nodes"] and postmaster_of(cfg, up):
                wait_streaming(cfg, st, name)
    say("up: %s (%.1f s)" % ("; ".join(report), time.time() - t0))
    return EXIT_OK


def cmd_down(cfg, args):
    t0 = time.time()
    if not os.path.isdir(cfg.home):
        say("down: nothing was running (no home at %s)" % cfg.home)
        return EXIT_OK
    with home_lock(cfg):
        load_state(cfg)          # validates the port base against an existing home
        stopped = stop_everything_found(cfg)
    say("down: %s (%.1f s)" % ("stopped " + ", ".join(stopped) if stopped else "nothing was running",
                               time.time() - t0))
    return EXIT_OK


def cmd_reset(cfg, args):
    t0 = time.time()
    with home_lock(cfg):
        load_state(cfg)          # validates the port base against an existing home
        build_fresh(cfg)
    say("reset: wiped %s and started primary (%d) and replica (%d) in %.1f s"
        % (cfg.home, cfg.port_base, cfg.port_base + 1, time.time() - t0))
    return EXIT_OK


def next_free(cfg, st):
    used = {n["port"] for n in st["nodes"].values()}
    for i in range(MAX_NODES):
        port = cfg.port_base + i
        if port not in used:
            return i, port
    raise Fail("all %d node ports are in use" % MAX_NODES)


def cmd_add_standby(cfg, args):
    t0 = time.time()
    with home_lock(cfg):
        st = require_state(cfg)
        upstream = current_primary(cfg, st, args.source)
        i, port = next_free(cfg, st)
        name = args.name or "standby%d" % i
        if not NAME_RX.match(name) or name in st["nodes"]:
            raise Fail("invalid or existing node name %r" % name, EXIT_USAGE)
        create_standby(cfg, st, name, port, upstream)
    say("add-standby: %s on port %d streaming from %s (%.1f s)" % (name, port, upstream, time.time() - t0))
    return EXIT_OK


def cmd_promote(cfg, args):
    t0 = time.time()
    with home_lock(cfg):
        st = require_state(cfg)
        name = resolve_node(cfg, st, args.node)
        port = st["nodes"][name]["port"]
        if not postmaster_of(cfg, name):
            raise Fail("%s is not running" % name)
        info = node_info(cfg, port)
        if not info["in_recovery"]:
            raise Fail("%s is not a standby" % name)
        old_tli = timeline_of(info)
        run([cfg.bin("pg_ctl"), "promote", "-D", cfg.data_dir(name), "-w", "-t", "60"], T_CTL, cfg=cfg)
        deadline = time.time() + 60
        while psql(cfg, port, "select pg_is_in_recovery()") != "f":
            if time.time() > deadline:
                raise Fail("%s still in recovery 60 s after promote" % name)
            time.sleep(0.1)
        new_tli = timeline_of(node_info(cfg, port))
        node = st["nodes"][name]
        former = node.get("upstream")
        dropped = drop_slot_on(cfg, st, former, node["slot"]) if node.get("slot") else False
        node.update({"upstream": None, "slot": None, "promoted_from": former})
        save_state(cfg, st)
        write_node_conf(cfg, st, name)
    out = {"node": name, "port": port, "old_timeline": old_tli, "new_timeline": new_tli,
           "seconds": round(time.time() - t0, 2), "former_upstream": former, "dropped_slot_on_former": dropped}
    if args.json:
        say(json.dumps(out))
    else:
        say("promote: %s (%d) is primary, timeline %s -> %s (%.1f s)" % (name, port, old_tli, new_tli,
                                                                          time.time() - t0))
    return EXIT_OK


def cmd_follow(cfg, args):
    t0 = time.time()
    with home_lock(cfg):
        st = require_state(cfg)
        name = resolve_node(cfg, st, args.node)
        target = current_primary(cfg, st, args.upstream)
        if not is_standby_dir(cfg, name):
            raise Fail("%s is not a standby" % name, EXIT_USAGE)
        node = st["nodes"][name]
        old_up, old_slot = node.get("upstream"), node.get("slot")
        slot = "cdc_v2_phys_" + name
        psql(cfg, st["nodes"][target]["port"],
             "select pg_create_physical_replication_slot({s}, true) where not exists "
             "(select 1 from pg_replication_slots where slot_name = {s});".format(s=lit(slot)))
        node.update({"upstream": target, "slot": slot})
        save_state(cfg, st)
        write_node_conf(cfg, st, name)
        if postmaster_of(cfg, name):
            stop_node(cfg, name)
        start_node(cfg, name)
        wait_streaming(cfg, st, name)
        if old_up and old_up != target and old_slot:
            drop_slot_on(cfg, st, old_up, old_slot)
    say("follow: %s streams from %s (%.1f s)" % (name, target, time.time() - t0))
    return EXIT_OK


def cmd_kill(cfg, args):
    with home_lock(cfg):
        st = require_state(cfg)
        name = resolve_node(cfg, st, args.node)
        pids = hard_kill(cfg, name)
    say("kill: %s" % ("SIGKILL %s: postmaster %d and %d children" % (name, pids[0], len(pids) - 1)
                      if pids else "%s was not running" % name))
    return EXIT_OK


def cmd_remove(cfg, args):
    with home_lock(cfg):
        st = require_state(cfg)
        name = resolve_node(cfg, st, args.node)
        remove_node(cfg, st, name)
    say("remove: %s stopped and deleted" % name)
    return EXIT_OK


def parse_assignments(items):
    out = {}
    for it in items:
        if "=" not in it:
            raise Fail("expected NAME=VALUE, got %r" % it, EXIT_USAGE)
        k, v = it.split("=", 1)
        k = k.strip().lower()
        if not SETTING_RX.match(k):
            raise Fail("invalid setting name %r" % k, EXIT_USAGE)
        if k in ("port", "unix_socket_directories", "listen_addresses", "primary_conninfo", "primary_slot_name",
                 "ssl", "ssl_cert_file", "ssl_key_file"):
            raise Fail("%s is managed by localpg and cannot be overridden" % k, EXIT_USAGE)
        out[k] = v.strip()
    return out


def apply_settings(cfg, st, names, keys):
    """Reload or restart the running nodes among `names` so that `keys` take effect. Returns a report."""
    report = []
    for name in names:
        port = st["nodes"][name]["port"]
        if not postmaster_of(cfg, name):
            report.append("%s: stopped (applies at next start)" % name)
            continue
        psql(cfg, port, "select pg_reload_conf();")
        time.sleep(0.2)
        errs = psql_json(cfg, port, "select coalesce(json_agg(json_build_object('name', name, 'error', error)), "
                                    "'[]'::json) from pg_file_settings where error is not null;") or []
        # "setting could not be applied" means: postmaster context, needs a restart. A restart-only setting whose
        # line was removed (`unset`) shows up as an error without a name: 'parameter "x" cannot be changed without
        # restarting the server'.
        restart_rx = re.compile(r'parameter "([^"]+)" cannot be changed without restarting the server')
        needs = set()
        real = []
        for e in errs:
            m = restart_rx.search(e["error"] or "")
            if e["error"] == "setting could not be applied":
                needs.add(e["name"])
            elif m:
                needs.add(m.group(1))
            else:
                real.append(e)
        if real:
            raise Fail("%s: configuration error: %s" % (name, "; ".join("%s: %s" % (e["name"] or "?", e["error"])
                                                                         for e in real)))
        pending = sorted({n for n in needs if n} | set(filter(None, (psql(
            cfg, port, "select string_agg(name, ',') from pg_settings where pending_restart;") or "").split(","))))
        pending = ",".join(pending)
        how = "reloaded"
        if pending:
            stop_node(cfg, name)
            start_node(cfg, name)
            how = "restarted (%s)" % pending
        values = psql_json(cfg, port, "select coalesce(json_object_agg(name, current_setting(name)), "
                                      "'{}'::json) from pg_settings where name = any(array[%s]);"
                           % ",".join(lit(k) for k in keys)) if keys else {}
        report.append("%s: %s %s" % (name, how, " ".join("%s=%s" % kv for kv in sorted(values.items()))))
    return report


def matched_value_rises(cfg, st, names, key, new_value):
    """Whether the new value of `key` (None: back to localpg's base value or the server default) is larger than the
    value a running node of `names` has now."""
    base = dict(BASE_SETTINGS).get(key)
    for n in names:
        if not postmaster_of(cfg, n):
            continue
        row = psql_json(cfg, st["nodes"][n]["port"], "select json_build_object('cur', setting, 'boot', boot_val) "
                                                     "from pg_settings where name = %s;" % lit(key))
        if not row:
            continue
        target = new_value if new_value is not None else (base if base is not None else row["boot"])
        try:
            if int(target) > int(row["cur"]):
                return True
        except (TypeError, ValueError):
            continue
    return False


def cmd_set(cfg, args):
    with home_lock(cfg):
        st = require_state(cfg)
        names = list(st["nodes"]) if args.node == "all" else [resolve_node(cfg, st, args.node)]
        if args.unset:
            keys = [k.strip().lower() for k in args.assignments]
            for n in names:
                for k in keys:
                    st["nodes"][n]["overrides"].pop(k, None)
        else:
            changes = parse_assignments(args.assignments)
            keys = list(changes)
            matched = sorted(set(keys) & STANDBY_MATCHED)
            if matched and args.node != "all":
                note("warning: a standby needs %s >= its primary's value; consider `localpg set all ...`"
                     % ", ".join(matched))
            for n in names:
                major = data_major(cfg, n)
                for k in keys:
                    if major is not None and major < SINCE.get(k, 0):
                        raise Fail("%s needs Postgres %d or later; node %s runs Postgres %d"
                                   % (k, SINCE[k], n, major), EXIT_USAGE)
            for n in names:
                port = st["nodes"][n]["port"]
                if postmaster_of(cfg, n):
                    known = psql(cfg, port, "select string_agg(name, ',') from pg_settings where name = any(array[%s]);"
                                 % ",".join(lit(k) for k in keys)) or ""
                    unknown = set(keys) - set(known.split(","))
                    if unknown:
                        raise Fail("unknown setting(s): %s" % ", ".join(sorted(unknown)), EXIT_USAGE)
                st["nodes"][n]["overrides"].update(changes)
        # A standby refuses to run with a smaller value of a STANDBY_MATCHED setting than its primary: when such a
        # value goes up, restart the standbys first; when it goes down, the primaries first.
        raising = any(matched_value_rises(cfg, st, names, k, None if args.unset else changes[k])
                      for k in set(keys) & STANDBY_MATCHED)
        names = [n for n in ordered_nodes(cfg, st, standbys_first=raising) if n in names]
        save_state(cfg, st)
        for n in names:
            write_node_conf(cfg, st, n)
        report = apply_settings(cfg, st, names, keys)
    for r in report:
        say(("unset: " if args.unset else "set: ") + r)
    return EXIT_OK


def gather_status(cfg):
    st = load_state(cfg)
    out = {"home": cfg.home, "port_base": cfg.port_base, "initialized": bool(st and st.get("initialized")),
           "nodes": [], "bin_major": cfg.bin_major() if os.access(os.path.join(cfg.pg_bin, "postgres"), os.X_OK)
           else None}
    if not st:
        return out, False
    infos = {}
    for name in sorted(st["nodes"], key=lambda n: st["nodes"][n]["port"]):
        node = st["nodes"][name]
        pm = postmaster_of(cfg, name)
        rec = {"name": name, "port": node["port"], "running": bool(pm), "pid": pm.pid if pm else None,
               "upstream": node.get("upstream"), "ready": node.get("ready", False),
               "role": "standby" if is_standby_dir(cfg, name) else "primary",
               "pg_major": data_major(cfg, name), "overrides": node.get("overrides", {})}
        if pm:
            try:
                info = node_info(cfg, node["port"])
            except Fail as e:
                info, rec["error"] = None, str(e)
            if info:
                infos[name] = info
                wr = info.get("wal_receiver") or {}
                rec.update({"role": "standby" if info["in_recovery"] else "primary",
                            "server_version": info["server_version"],
                            "server_version_num": info["server_version_num"], "timeline": timeline_of(info),
                            "current_lsn": info["current_lsn"], "receive_lsn": info["receive_lsn"],
                            "replay_lsn": info["replay_lsn"], "wal_receiver_status": wr.get("status"),
                            "replay_pause_state": info["replay_pause_state"],
                            "replication": info["replication"], "slots": info["slots"]})
        out["nodes"].append(rec)
    by_name = {r["name"]: r for r in out["nodes"]}
    for r in out["nodes"]:
        if r["role"] != "standby" or not r["running"]:
            continue
        up = by_name.get(r.get("upstream") or "")
        if up and up.get("current_lsn") and r.get("replay_lsn"):
            r["replay_lag_bytes"] = max(0, lsn_int(up["current_lsn"]) - lsn_int(r["replay_lsn"]))
        for repl in (up or {}).get("replication", []):
            if repl["application_name"] == r["name"]:
                r["replication_state"] = repl["state"]
                r["replay_lag_s"] = repl["replay_lag_s"]
    all_running = out["initialized"] and all(r["running"] for r in out["nodes"])
    out["all_running"] = all_running
    majors = {r["pg_major"] for r in out["nodes"] if r["pg_major"] is not None}
    out["pg_major"] = majors.pop() if len(majors) == 1 else (st.get("pg_major") if not majors else None)
    return out, all_running


def fmt_bytes(n):
    if n is None:
        return "-"
    for unit in ("B", "kB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0


def cmd_status(cfg, args):
    out, all_running = gather_status(cfg)
    if args.json:
        say(json.dumps(out, indent=2, default=str))
        return EXIT_OK if all_running else EXIT_NOT_RUNNING
    if not out["nodes"]:
        say("no cluster in %s" % cfg.home)
        return EXIT_NOT_RUNNING
    say("home %s, port base %d, Postgres %s%s" % (cfg.home, cfg.port_base, out.get("pg_major") or "?",
                                                  "" if out["initialized"] else " (half-initialised)"))
    rows = [("NODE", "PORT", "STATE", "ROLE", "VERSION", "TLI", "LSN (current/replay)", "UPSTREAM", "REPLICATION",
             "LAG")]
    for r in out["nodes"]:
        lsn = r.get("current_lsn") or r.get("replay_lsn") or "-"
        lag = "-"
        if r["role"] == "standby" and r["running"]:
            lag = fmt_bytes(r.get("replay_lag_bytes"))
            if r.get("replay_lag_s") is not None:
                lag += " / %.2f s" % r["replay_lag_s"]
        repl = r.get("replication_state") or r.get("wal_receiver_status") or "-"
        if r.get("replay_pause_state") not in (None, "not paused"):
            repl += " (replay %s)" % r["replay_pause_state"]
        if r["role"] == "primary":
            repl = "%d sender(s)" % len(r.get("replication") or []) if r["running"] else "-"
        rows.append((r["name"], str(r["port"]), "running" if r["running"] else "stopped", r["role"],
                     r.get("server_version", "-"), str(r.get("timeline") or "-"), lsn,
                     r.get("upstream") or "-", repl, lag))
    widths = [max(len(row[i]) for row in rows) for i in range(len(rows[0]))]
    for row in rows:
        say("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())
    slots = [(r["name"], s) for r in out["nodes"] for s in (r.get("slots") or [])]
    if slots:
        say("slots:")
        srows = [("NODE", "SLOT", "TYPE", "ACTIVE", "WAL_STATUS", "FAILOVER", "SYNCED", "RESTART_LSN")]
        for n, s in slots:
            srows.append((n, s["slot_name"], s["slot_type"] + ("/" + s["plugin"] if s.get("plugin") else ""),
                          "yes" if s["active"] else "no", s.get("wal_status") or "-",
                          {True: "yes", False: "no"}.get(s.get("failover"), "-"),
                          {True: "yes", False: "no"}.get(s.get("synced"), "-"),
                          s.get("restart_lsn") or "-"))
        widths = [max(len(row[i]) for row in srows) for i in range(len(srows[0]))]
        for row in srows:
            say("  " + "  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())
    return EXIT_OK if all_running else EXIT_NOT_RUNNING


def dsn(cfg, port, role, db=DATABASE):
    return " ".join("%s=%s" % kv for kv in [("host", "localhost"), ("port", port), ("dbname", db), ("user", role),
                                             ("sslmode", "verify-full"), ("sslrootcert", cfg.ca_cert),
                                             ("passfile", cfg.pgpass)])


def cmd_conninfo(cfg, args):
    st = require_state(cfg)
    nodes = []
    for name in sorted(st["nodes"], key=lambda n: st["nodes"][n]["port"]):
        port = st["nodes"][name]["port"]
        nodes.append({"name": name, "port": port, "role": "standby" if is_standby_dir(cfg, name) else "primary",
                      "running": bool(postmaster_of(cfg, name)), "upstream": st["nodes"][name].get("upstream"),
                      "dsn_admin": dsn(cfg, port, ADMIN), "dsn_runtime": dsn(cfg, port, RUNTIME)})
    prim = [n for n in nodes if n["role"] == "primary"]
    stby = [n for n in nodes if n["role"] == "standby"]
    out = {"host": "localhost", "hosts": ["localhost", "127.0.0.1", "::1"], "socket_dir": cfg.run_dir,
           "database": DATABASE, "sslmode": "verify-full", "ca_cert": cfg.ca_cert,
           "passwords_json": cfg.passwords_json, "pgpass": cfg.pgpass, "roles": dict(ROLES),
           "primary": prim[0] if prim else None, "replica": stby[0] if stby else None, "nodes": nodes,
           "port_base": cfg.port_base}
    if args.show_passwords:
        out["passwords"] = {k: v["password"] for k, v in load_passwords(cfg).items()}
    if args.env:
        node = next((n for n in nodes if n["name"] == resolve_node(cfg, st, args.node)), None) if args.node \
            else out["primary"]
        role = ROLES[args.env]
        if args.env == "bootstrap":
            raise Fail("the bootstrap superuser is for localpg only (Unix socket); use admin or runtime", EXIT_USAGE)
        for k, v in [("PGHOST", "localhost"), ("PGPORT", node["port"]), ("PGDATABASE", DATABASE), ("PGUSER", role),
                     ("PGSSLMODE", "verify-full"), ("PGSSLROOTCERT", cfg.ca_cert), ("PGPASSFILE", cfg.pgpass)]:
            say("export %s=%s" % (k, libpq_quote(v) if " " in str(v) else v))
        return EXIT_OK
    if args.json:
        say(json.dumps(out, indent=2))
        return EXIT_OK
    say("database %s on localhost (TLS only: sslmode=verify-full sslrootcert=%s)" % (DATABASE, cfg.ca_cert))
    say("roles: admin %s, runtime %s (bootstrap superuser %s: localpg only, Unix socket)" % (ADMIN, RUNTIME, BOOT))
    say("password files (mode 600): %s, %s" % (cfg.passwords_json, cfg.pgpass))
    for n in nodes:
        say("  %-10s %-8s port %d  %s" % (n["name"], n["role"], n["port"], n["dsn_runtime"]))
    if args.show_passwords:
        for k, v in out["passwords"].items():
            say("password %s: %s" % (ROLES[k], v))
    return EXIT_OK


def cmd_sql(cfg, args):
    st = require_state(cfg)
    name = resolve_node(cfg, st, args.node)
    port = st["nodes"][name]["port"]
    sql = args.command if args.command is not None else sys.stdin.read()
    db = args.db or (DATABASE if args.role != "bootstrap" else "postgres")
    if args.role == "bootstrap":
        out = psql(cfg, port, sql, db=db, timeout=args.timeout)
    else:
        assert_own_port(cfg, port)
        cmd = [cfg.bin("psql"), "-X", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1", "-d",
               dsn(cfg, port, ROLES[args.role], db), "-f", "-"]
        out = run(cmd, args.timeout, cfg=cfg, input=sql).stdout.strip()
    if out:
        say(out)
    return EXIT_OK


def cmd_logs(cfg, args):
    st = require_state(cfg)
    name = resolve_node(cfg, st, args.node)
    try:
        with open(cfg.log_file(name), errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        raise Fail("no log for %s" % name)
    for l in lines[-args.lines:]:
        say(l)
    return EXIT_OK


# --------------------------------------------------------------------------------------------------- CLI

def build_parser():
    p = argparse.ArgumentParser(prog="localpg", description="Manage this build's local Postgres primary and "
                                "standbys (PLAN §5). Exit codes: 0 ok, 1 error, 2 usage/refused, 3 not running.")
    p.add_argument("--home", help="data home (default $CDC_V2_PG_HOME or %s)" % DEFAULT_HOME)
    p.add_argument("--port-base", type=int, help="first port (default $CDC_V2_PG_PORT_BASE or %d); nodes use "
                   "base..base+%d" % (DEFAULT_PORT_BASE, MAX_NODES - 1))
    p.add_argument("--pg-bin", help="Postgres binaries (default $CDC_V2_PG_BIN or %s)" % DEFAULT_PG_BIN)
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    sub.required = True
    sub.add_parser("up", help="start primary and replica, building them if needed (idempotent)")
    sub.add_parser("down", help="stop every node of this home; leaves no process behind")
    sub.add_parser("reset", help="stop, wipe and rebuild from any state, then start")
    s = sub.add_parser("status", help="nodes, roles, timelines, LSNs, replication and slots")
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("add-standby", help="add a streaming standby of the current primary")
    s.add_argument("--name", help="node name (default standbyN, N = port offset)")
    s.add_argument("--from", dest="source", help="primary to clone and follow (default: the running primary)")
    s = sub.add_parser("promote", help="promote a standby; reports the new timeline")
    s.add_argument("node")
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("follow", help="re-point a standby at another primary (e.g. after a promotion)")
    s.add_argument("node")
    s.add_argument("upstream", nargs="?", help="new upstream (default: the running primary)")
    s = sub.add_parser("kill", help="SIGKILL a node's postmaster and all its children (crash test)")
    s.add_argument("node")
    s = sub.add_parser("remove", help="stop a node, drop its slot upstream and delete its data")
    s.add_argument("node")
    s = sub.add_parser("set", help="override server settings on one node (or all) and reload/restart as needed")
    s.add_argument("node", help="node name, port, or 'all'")
    s.add_argument("assignments", nargs="+", metavar="NAME=VALUE")
    s.set_defaults(unset=False)
    s = sub.add_parser("unset", help="remove setting overrides and reload/restart as needed")
    s.add_argument("node", help="node name, port, or 'all'")
    s.add_argument("assignments", nargs="+", metavar="NAME")
    s.set_defaults(unset=True)
    s = sub.add_parser("conninfo", help="connection facts (never passwords unless --show-passwords)")
    s.add_argument("--json", action="store_true")
    s.add_argument("--show-passwords", action="store_true", help="print the generated passwords")
    s.add_argument("--env", choices=["admin", "runtime", "bootstrap"], help="print libpq export lines for a role")
    s.add_argument("--node", help="node for --env (default: the primary)")
    s = sub.add_parser("sql", help="run SQL on a node (bootstrap: Unix socket; admin/runtime: TLS verify-full)")
    s.add_argument("node")
    s.add_argument("-c", "--command", help="SQL (default: read stdin)")
    s.add_argument("--role", choices=list(ROLES), default="bootstrap")
    s.add_argument("--db", help="database (default %s; postgres for bootstrap)" % DATABASE)
    s.add_argument("--timeout", type=int, default=T_SQL)
    s = sub.add_parser("logs", help="print the end of a node's server log")
    s.add_argument("node")
    s.add_argument("-n", "--lines", type=int, default=40)
    return p


COMMANDS = {"up": cmd_up, "down": cmd_down, "reset": cmd_reset, "status": cmd_status, "add-standby": cmd_add_standby,
            "promote": cmd_promote, "follow": cmd_follow, "kill": cmd_kill, "remove": cmd_remove, "set": cmd_set,
            "unset": cmd_set, "conninfo": cmd_conninfo, "sql": cmd_sql, "logs": cmd_logs}


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        cfg = Config(args.home, args.port_base, args.pg_bin)
        return COMMANDS[args.cmd](cfg, args)
    except Fail as e:
        print("localpg: error: %s" % e, file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        print("localpg: interrupted", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
